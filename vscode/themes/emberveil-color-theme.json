  "tokenColors": [
    { "name": "Plain text and variables", "scope": ["source", "variable", "variable.other.readwrite", "punctuation", "meta.brace"], "settings": { "foreground": "#35383F" } },
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#58616B", "fontStyle": "italic" } },
    { "name": "Documentation comments", "scope": ["comment.block.documentation", "comment.line.documentation", "storage.type.class.jsdoc", "entity.name.type.instance.jsdoc", "variable.other.jsdoc", "keyword.other.documentation"], "settings": { "foreground": "#45653A", "fontStyle": "italic" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#46661F" } },
    { "name": "String interpolation", "scope": ["meta.interpolation", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#934827" } },
    { "name": "Regular expressions", "scope": ["string.regexp", "constant.other.character-class.regexp", "keyword.operator.quantifier.regexp"], "settings": { "foreground": "#45653A" } },
    { "name": "Numbers", "scope": ["constant.numeric", "constant.language.numeric"], "settings": { "foreground": "#704C87" } },
    { "name": "Language constants", "scope": ["constant.language", "constant.language.boolean", "constant.language.null", "variable.language.this", "variable.language.super"], "settings": { "foreground": "#A44012" } },
    { "name": "Constants and enum members", "scope": ["constant.other", "variable.other.enummember"], "settings": { "foreground": "#704C87" } },
    { "name": "Control-flow keywords", "scope": ["keyword.control", "keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.exception", "keyword.control.return", "keyword.control.import", "keyword.control.export"], "settings": { "foreground": "#A44012", "fontStyle": "bold" } },
    { "name": "Keywords and storage", "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.declaration", "keyword.other"], "settings": { "foreground": "#A44012" } },
    { "name": "Operators", "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "punctuation.separator.key-value"], "settings": { "foreground": "#934827" } },
    { "name": "Functions and calls", "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call", "entity.name.function.member", "support.function.any-method"], "settings": { "foreground": "#875900" } },
    { "name": "Constructors", "scope": ["entity.name.function.constructor", "support.class.builtin", "meta.function-call.constructor"], "settings": { "foreground": "#1C6570" } },
    { "name": "Types and classes", "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface", "support.type", "support.class", "storage.type.cs", "storage.type.java"], "settings": { "foreground": "#1C6570" } },
    { "name": "Inherited and generic types", "scope": ["entity.other.inherited-class", "entity.name.type.parameter", "meta.type.parameters", "support.type.primitive"], "settings": { "foreground": "#0E687B" } },
    { "name": "Properties and fields", "scope": ["variable.other.property", "variable.other.object.property", "variable.other.member", "variable.other.field", "support.variable.property", "meta.object-literal.key", "constant.other.key"], "settings": { "foreground": "#914321" } },
    { "name": "Parameters", "scope": ["variable.parameter", "meta.function.parameters variable", "meta.parameters variable"], "settings": { "foreground": "#76532E" } },
    { "name": "Namespaces and modules", "scope": ["entity.name.namespace", "entity.name.module", "support.module", "variable.other.module"], "settings": { "foreground": "#1C6570" } },
    { "name": "Decorators and annotations", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "meta.annotation"], "settings": { "foreground": "#704C87" } },
    { "name": "Preprocessor and macros", "scope": ["keyword.control.directive", "keyword.control.import.include", "entity.name.function.preprocessor", "meta.preprocessor", "constant.other.preprocessor"], "settings": { "foreground": "#704C87" } },
    { "name": "HTML and XML tags", "scope": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"], "settings": { "foreground": "#0E687B" } },
    { "name": "Markup attributes", "scope": ["entity.other.attribute-name", "support.type.property-name.css", "meta.attribute"], "settings": { "foreground": "#914321" } },
    { "name": "CSS selectors", "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css", "meta.selector.css"], "settings": { "foreground": "#1C6570" } },
    { "name": "CSS properties", "scope": ["support.type.property-name.css", "meta.property-name.css"], "settings": { "foreground": "#914321" } },
    { "name": "JSON and YAML keys", "scope": ["support.type.property-name.json", "support.type.property-name.yaml", "entity.name.tag.yaml", "meta.mapping.key"], "settings": { "foreground": "#914321" } },
    { "name": "Markdown headings", "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"], "settings": { "foreground": "#875900", "fontStyle": "bold" } },
    { "name": "Markdown links", "scope": ["markup.underline.link", "string.other.link", "meta.link.inline", "punctuation.definition.link"], "settings": { "foreground": "#1C6570" } },
    { "name": "Markdown emphasis", "scope": ["markup.italic", "markup.quote"], "settings": { "foreground": "#45653A", "fontStyle": "italic" } },
    { "name": "Markdown strong", "scope": ["markup.bold"], "settings": { "foreground": "#A44012", "fontStyle": "bold" } },
    { "name": "Markup inserted", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#46661F" } },
    { "name": "Markup deleted", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#A33B42" } },
    { "name": "Markup changed", "scope": ["markup.changed", "meta.diff.range"], "settings": { "foreground": "#875900" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F7EDE0", "background": "#A33B42" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated", "entity.name.function.deprecated"], "settings": { "foreground": "#77736D", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "#1C6570",
    "type": "#1C6570",
    "class": "#1C6570",
    "enum": "#1C6570",
    "interface": "#0E687B",
    "struct": "#1C6570",
    "typeParameter": "#0E687B",
    "parameter": "#76532E",
    "variable": "#35383F",
    "variable.readonly": "#35383F",
    "variable.static": "#35383F",
    "property": "#914321",
    "property.readonly": "#795B50",
    "enumMember": "#704C87",
    "event": "#914321",
    "function": "#875900",
    "method": "#875900",
    "macro": "#704C87",
    "label": "#1C6570",
    "comment": { "foreground": "#58616B", "italic": true },
    "comment.documentation": { "foreground": "#45653A", "italic": true },
    "string": "#46661F",
    "keyword": "#A44012",
    "number": "#704C87",
    "regexp": "#45653A",
    "operator": "#934827",
    "decorator": "#704C87",
    "*.declaration": { "bold": true },
    "*.deprecated": "#77736D",
    "*.defaultLibrary": "#1C6570",
    "*.static": "#795B50"
  }
}
