  "tokenColors": [
    {
      "name": "Plain text and variables",
      "scope": ["source", "variable", "variable.other.readwrite", "punctuation", "meta.brace"],
      "settings": { "foreground": "#CCCAC2" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#727D8E", "fontStyle": "italic" }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation", "comment.line.documentation", "storage.type.class.jsdoc", "entity.name.type.instance.jsdoc", "variable.other.jsdoc", "keyword.other.documentation"],
      "settings": { "foreground": "#9FCF86", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#B8D982" }
    },
    {
      "name": "String interpolation",
      "scope": ["meta.interpolation", "punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#F0AA7A" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.other.character-class.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#9FCF86" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.language.numeric"],
      "settings": { "foreground": "#C8ABE6" }
    },
    {
      "name": "Language constants",
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null", "variable.language.this", "variable.language.super"],
      "settings": { "foreground": "#FF9F5B" }
    },
    {
      "name": "Constants and enum members",
      "scope": ["constant.other", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#C8ABE6" }
    },
    {
      "name": "Control-flow keywords",
      "scope": ["keyword.control", "keyword.control.flow", "keyword.control.conditional", "keyword.control.loop", "keyword.control.exception", "keyword.control.return", "keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#FF9F5B", "fontStyle": "bold" }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.declaration", "keyword.other"],
      "settings": { "foreground": "#FF9F5B" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "punctuation.separator.key-value"],
      "settings": { "foreground": "#F0AA7A" }
    },
    {
      "name": "Functions and calls",
      "scope": ["entity.name.function", "support.function", "variable.function", "meta.function-call", "entity.name.function.member", "support.function.any-method"],
      "settings": { "foreground": "#FFD173" }
    },
    {
      "name": "Constructors",
      "scope": ["entity.name.function.constructor", "support.class.builtin", "meta.function-call.constructor"],
      "settings": { "foreground": "#73C7D6" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface", "support.type", "support.class", "storage.type.cs", "storage.type.java"],
      "settings": { "foreground": "#73C7D6" }
    },
    {
      "name": "Inherited and generic types",
      "scope": ["entity.other.inherited-class", "entity.name.type.parameter", "meta.type.parameters", "support.type.primitive"],
      "settings": { "foreground": "#8FD2DE" }
    },
    {
      "name": "Properties and fields",
      "scope": ["variable.other.property", "variable.other.object.property", "variable.other.member", "variable.other.field", "support.variable.property", "meta.object-literal.key", "constant.other.key"],
      "settings": { "foreground": "#F29E74" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters variable", "meta.parameters variable"],
      "settings": { "foreground": "#E1C59C" }
    },
    {
      "name": "Namespaces and modules",
      "scope": ["entity.name.namespace", "entity.name.module", "support.module", "variable.other.module"],
      "settings": { "foreground": "#73C7D6" }
    },
    {
      "name": "Decorators and annotations",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "meta.annotation"],
      "settings": { "foreground": "#C8ABE6" }
    },
    {
      "name": "Preprocessor and macros",
      "scope": ["keyword.control.directive", "keyword.control.import.include", "entity.name.function.preprocessor", "meta.preprocessor", "constant.other.preprocessor"],
      "settings": { "foreground": "#C8ABE6" }
    },
    {
      "name": "HTML and XML tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"],
      "settings": { "foreground": "#5CCFE6" }
    },
    {
      "name": "Markup attributes",
      "scope": ["entity.other.attribute-name", "support.type.property-name.css", "meta.attribute"],
      "settings": { "foreground": "#F29E74" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css", "meta.selector.css"],
      "settings": { "foreground": "#73C7D6" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "meta.property-name.css"],
      "settings": { "foreground": "#F29E74" }
    },
    {
      "name": "JSON and YAML keys",
      "scope": ["support.type.property-name.json", "support.type.property-name.yaml", "entity.name.tag.yaml", "meta.mapping.key"],
      "settings": { "foreground": "#F29E74" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#FFD173", "fontStyle": "bold" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link.inline", "punctuation.definition.link"],
      "settings": { "foreground": "#73C7D6" }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.italic", "markup.quote"],
      "settings": { "foreground": "#9FCF86", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strong",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FF9F5B", "fontStyle": "bold" }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#9FCF86" }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#F07178" }
    },
    {
      "name": "Markup changed",
      "scope": ["markup.changed", "meta.diff.range"],
      "settings": { "foreground": "#FFD173" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFF3E3", "background": "#A94E57" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated", "entity.name.function.deprecated"],
      "settings": { "foreground": "#8D94A2", "fontStyle": "strikethrough" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#73C7D6",
    "type": "#73C7D6",
    "class": "#73C7D6",
    "enum": "#73C7D6",
    "interface": "#8FD2DE",
    "struct": "#73C7D6",
    "typeParameter": "#8FD2DE",
    "parameter": "#E1C59C",
    "variable": "#CCCAC2",
    "variable.readonly": "#C8ABE6",
    "property": "#F29E74",
    "property.readonly": "#D9B0A0",
    "enumMember": "#C8ABE6",
    "event": "#F29E74",
    "function": "#FFD173",
    "method": "#FFD173",
    "macro": "#C8ABE6",
    "label": "#73C7D6",
    "comment": { "foreground": "#727D8E", "italic": true },
    "comment.documentation": { "foreground": "#9FCF86", "italic": true },
    "string": "#B8D982",
    "keyword": "#FF9F5B",
    "number": "#C8ABE6",
    "regexp": "#9FCF86",
    "operator": "#F0AA7A",
    "decorator": "#C8ABE6",
    "*.declaration": { "bold": true },
    "*.deprecated": "#8D94A2",
    "*.defaultLibrary": "#73C7D6",
    "*.static": "#D9B0A0"
  }
}
