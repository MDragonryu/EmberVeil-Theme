; Emberveil Light - safe Windows shell theme
; Uses only the built-in Aero visual style.
; Wallpaper, cursors and sounds are intentionally left untouched.

[Theme]
DisplayName=Emberveil Light

[VisualStyles]
Path=%ResourceDir%\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Light
AppMode=Light

[MasterThemeSelector]
MTSM=DABJDKT
