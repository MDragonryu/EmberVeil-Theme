; Emberveil Dark - safe Windows shell theme
; Uses only the built-in Aero visual style.
; Wallpaper, cursors and sounds are intentionally left untouched.

[Theme]
DisplayName=Emberveil Dark

[VisualStyles]
Path=%ResourceDir%\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
SystemMode=Dark
AppMode=Dark

[MasterThemeSelector]
MTSM=DABJDKT
